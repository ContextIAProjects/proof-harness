{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval_result.schema.json",
  "title": "RetrievalResult",
  "description": "Deterministic output of `experience search` (increment 4, D16-D19). A pure function of (bank bytes, grafos index, query): no timestamps, no volatile fields, so the WHOLE document is canonical and must reproduce byte-identical for a frozen bank+index. Stale experiences cannot appear under results: the schema itself enforces the Phase 2 acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "pinned", "results", "discarded"],
  "properties": {
    "schema_version": { "const": 1 },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_type", "any_task_type", "strict_validity"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "task_type": { "type": "string", "minLength": 1 },
        "any_task_type": { "type": "boolean" },
        "strict_validity": { "type": "boolean" }
      }
    },
    "pinned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank_content_hash", "grafos_index_id"],
      "properties": {
        "bank_content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of the exact experiences.jsonl bytes the search ran against"
        },
        "grafos_index_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{16}$" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["successes", "failures"],
      "properties": {
        "successes": { "type": "array", "items": { "$ref": "#/$defs/retrieved" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/retrieved" } }
      }
    },
    "discarded": { "type": "array", "items": { "$ref": "#/$defs/discarded" } }
  },
  "$defs": {
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "retrieved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experience_id",
        "run_id",
        "harness_id",
        "task_features_ref",
        "outcome",
        "context_present",
        "effective_validity",
        "filters_passed"
      ],
      "properties": {
        "experience_id": { "type": "string", "pattern": "^EXP-[0-9]{3,}$" },
        "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{3,}$" },
        "harness_id": { "type": "string", "pattern": "^harness-[0-9]{3,}$" },
        "task_features_ref": {
          "type": "string",
          "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9/._-]*$"
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["success", "primary_reward"],
          "properties": {
            "success": { "type": "boolean" },
            "primary_reward": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "context_present": {
          "type": "boolean",
          "description": "true when the trajectory was driven by a compiled package (envelope.context present)"
        },
        "effective_validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": { "type": "string", "enum": ["current", "suspect"] },
            "reasons": { "$ref": "#/$defs/reasons" }
          },
          "if": { "properties": { "status": { "const": "current" } } },
          "else": { "properties": { "reasons": { "$ref": "#/$defs/reasons", "minItems": 1 } } }
        },
        "filters_passed": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "discarded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_id", "reason", "effective_validity"],
      "properties": {
        "experience_id": { "type": "string", "pattern": "^EXP-[0-9]{3,}$" },
        "reason": { "type": "string", "minLength": 1 },
        "effective_validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasons"],
          "properties": {
            "status": { "type": "string", "enum": ["current", "suspect", "stale"] },
            "reasons": { "$ref": "#/$defs/reasons" }
          },
          "if": { "properties": { "status": { "const": "current" } } },
          "else": { "properties": { "reasons": { "$ref": "#/$defs/reasons", "minItems": 1 } } }
        }
      }
    }
  }
}
