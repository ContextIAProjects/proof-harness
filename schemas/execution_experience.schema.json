{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-harness.dev/schemas/v1/execution_experience.schema.json",
  "title": "ExecutionExperience",
  "description": "Normalized unit used for learning, derived deterministically from a TrajectoryEnvelope. Increment 1 ingests WITHOUT diagnosing: diagnosis is optional and arrives in Fase 2. referenced_symbols only contains ids verified against Grafos; whatever failed verification is preserved in validity.quarantined_refs (quarantining never deletes). External identifiers travel verbatim (git revision, grafos index_id).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experience_id",
    "run_id",
    "task_features_ref",
    "harness_id",
    "trajectory_ref",
    "outcome",
    "cost",
    "validity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experience_id": { "type": "string", "pattern": "^EXP-[0-9]{3,}$" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{8}-[0-9]{3,}$" },
    "task_features_ref": { "$ref": "#/$defs/artifactUri" },
    "harness_id": { "type": "string", "pattern": "^harness-[0-9]{3,}$" },
    "harness_delta_ref": {
      "anyOf": [{ "$ref": "#/$defs/artifactUri" }, { "type": "null" }]
    },
    "trajectory_ref": { "$ref": "#/$defs/artifactUri" },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "primary_reward", "verifier_results"],
      "properties": {
        "success": { "type": "boolean" },
        "primary_reward": { "type": "number", "minimum": 0, "maximum": 1 },
        "verifier_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactUri" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_tokens", "non_cached_tokens", "latency_ms"],
      "properties": {
        "total_tokens": { "type": "integer", "minimum": 0 },
        "non_cached_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "monetary_cost": {
          "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_dimension", "confidence", "evidence_refs"],
      "description": "Absent in increment 1 (no diagnosis at ingest time). When present, an LLM may have written the analysis, but it cannot alter verifier results nor invent evidence.",
      "properties": {
        "primary_dimension": { "$ref": "#/$defs/dimension" },
        "secondary_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "analysis": { "type": "string", "minLength": 1 }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_revision", "grafos_index_id", "referenced_symbols", "status"],
      "properties": {
        "repository_revision": {
          "type": "string",
          "pattern": "^git:[a-f0-9]{7,40}$"
        },
        "grafos_index_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{16}$",
          "description": "Grafos index_id verbatim (its native short form)."
        },
        "referenced_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Only ids that resolved against the Grafos index."
        },
        "status": {
          "type": "string",
          "enum": ["current", "suspect", "stale", "invalidated", "revalidated"]
        },
        "quarantined_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "reason"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactUri": {
      "type": "string",
      "pattern": "^artifact://[A-Za-z0-9][A-Za-z0-9/._-]*$"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "context",
        "tools",
        "generation",
        "orchestration",
        "memory",
        "output",
        "model_capability",
        "environment",
        "contract_input"
      ]
    }
  }
}
